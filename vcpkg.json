{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "dentalviz",
  "version-semver": "0.1.0",
  "description": "C++ dental mesh visualization and geometry interaction",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "assimp",
    "catch2",
    {
      "name": "glad",
      "features": [
        "gl-api-33"
      ]
    },
    "glfw3",
    "glm",
    {
      "name": "imgui",
      "features": [
        "glfw-binding",
        "opengl3-binding"
      ]
    }
  ]
}
